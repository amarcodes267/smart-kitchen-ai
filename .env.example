# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-secret-key-in-production
PORT=5000

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///smart_kitchen.db

# For Production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_kitchen

# Generative AI (Optional for Gemini Recipe Studio)
GEMINI_API_KEY=your_gemini_api_key_here

